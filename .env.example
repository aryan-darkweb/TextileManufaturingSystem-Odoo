# TextileFlow Root Environment Template
# See backend/.env.example for the active configuration file.

# Express Server Port
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Runtime Pooled / Standard)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma Migrations (Port 5432, advisory locks)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres"

# Frontend Vite Dev Server Origin
CORS_ORIGIN="http://localhost:5173"
