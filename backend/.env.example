# ==============================================================================
# TextileFlow Backend Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env and supply your actual Supabase connection strings.
# NEVER commit .env to GitHub. Keep credentials secret.

# Express Server Port (Monolithic server running all modules)
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection Strings
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Used by Prisma Client for application runtime queries.
# If connection pooling is enabled in Supabase (recommended for production/pooler):
# Use the Supavisor Pooler URL (Transaction mode, typically port 6543):
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# In local development without pooler, you may also use the direct port 5432 string.
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL:
# Used exclusively by Prisma for database migrations (e.g. prisma migrate dev/deploy).
# Migrations require direct connection (Session mode, port 5432) to acquire advisory locks.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres"

# Frontend Origin for CORS (e.g. http://localhost:5173 for Vite dev server)
CORS_ORIGIN="http://localhost:5173"
